#!/usr/bin/with-contenv bashio
set -Eeuo pipefail

readonly OPTIONS_FILE=/data/options.json
readonly RUNTIME_DIR=/run/codex-desktop
readonly ENV_FILE="${RUNTIME_DIR}/environment"
readonly STARTUP_FILE="${RUNTIME_DIR}/startup.sh"
readonly ARGS_FILE="${RUNTIME_DIR}/arguments"
readonly DISPLAY=:0
pids=()

cleanup() {
  bashio::log.info "Stopping desktop services..."
  ((${#pids[@]} == 0)) || kill "${pids[@]}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

mkdir -p "${RUNTIME_DIR}" /config/codex
chmod 700 "${RUNTIME_DIR}"

if [[ ! -f "${OPTIONS_FILE}" ]]; then
  bashio::log.fatal "Add-on options were not mounted at ${OPTIONS_FILE}."
  exit 1
fi

bashio::log.info "Updating Codex CLI to the latest npm release..."
if ! npm install --global --no-audit --no-fund @openai/codex@latest; then
  bashio::log.fatal "Codex CLI update failed; refusing to start an unknown or stale CLI."
  exit 1
fi
bashio::log.info "Codex CLI ready: $(codex --version)"

printf 'export HOME=/config\nexport CODEX_HOME=/config/codex\n' > "${ENV_FILE}"
chmod 600 "${ENV_FILE}"
while IFS= read -r entry; do
  [[ -z "${entry}" ]] && continue
  if [[ "${entry}" != *=* ]]; then
    bashio::log.warning "Ignoring an environment entry without '='."
    continue
  fi
  name=${entry%%=*}
  value=${entry#*=}
  if [[ ! "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    bashio::log.warning "Ignoring an environment entry with an invalid variable name: ${name}"
    continue
  fi
  printf 'export %s=%q\n' "${name}" "${value}" >> "${ENV_FILE}"
done < <(jq -r '.environment[]? // empty' "${OPTIONS_FILE}")

jq -r '.startup_script // ""' "${OPTIONS_FILE}" > "${STARTUP_FILE}"
chmod 700 "${STARTUP_FILE}"
jq -r '.codex_arguments[]? // empty | @sh' "${OPTIONS_FILE}" > "${ARGS_FILE}"
chmod 600 "${ARGS_FILE}"

working_directory=$(jq -r '.working_directory // "/share"' "${OPTIONS_FILE}")
if [[ ! -d "${working_directory}" ]]; then
  bashio::log.warning "Working directory ${working_directory} does not exist; using /share."
  working_directory=/share
fi
printf '%s' "${working_directory}" > "${RUNTIME_DIR}/working-directory"

resolution=$(jq -r '.resolution // "1440x900"' "${OPTIONS_FILE}")
if [[ ! "${resolution}" =~ ^[0-9]{3,4}x[0-9]{3,4}$ ]]; then
  bashio::log.warning "Invalid resolution; using 1440x900."
  resolution=1440x900
fi

bashio::log.info "Running the configured startup script..."
set -a
# shellcheck disable=SC1090
source "${ENV_FILE}"
set +a
cd "${working_directory}"
if ! bash "${STARTUP_FILE}"; then
  bashio::log.fatal "The startup script failed."
  exit 1
fi

bashio::log.info "Starting virtual display ${resolution}..."
Xvfb "${DISPLAY}" -screen 0 "${resolution}x24" -nolisten tcp -noreset &
pids+=("$!")
for _ in $(seq 1 50); do
  [[ -S /tmp/.X11-unix/X0 ]] && break
  sleep 0.1
done
if [[ ! -S /tmp/.X11-unix/X0 ]]; then
  bashio::log.fatal "The virtual display failed to start."
  exit 1
fi

export DISPLAY
export XDG_RUNTIME_DIR="${RUNTIME_DIR}/xdg"
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"

dbus-daemon --session --fork --print-address=1 > "${RUNTIME_DIR}/dbus-address"
export DBUS_SESSION_BUS_ADDRESS
DBUS_SESSION_BUS_ADDRESS=$(cat "${RUNTIME_DIR}/dbus-address")

openbox-session &
pids+=("$!")
pcmanfm --desktop --profile codex-desktop &
pids+=("$!")
lxterminal --title="Codex Desktop" --geometry=140x42 --command=/usr/local/bin/codex-session &
pids+=("$!")

bashio::log.info "Starting private VNC bridge and Home Assistant Ingress web desktop..."
x11vnc -display "${DISPLAY}" -localhost -rfbport 5900 -forever -shared -nopw -noxdamage &
pids+=("$!")

# Only the noVNC HTTP/WebSocket endpoint is exposed. VNC itself listens on loopback.
websockify --web=/usr/share/novnc 7681 localhost:5900 &
websockify_pid=$!
pids+=("${websockify_pid}")
wait "${websockify_pid}"
