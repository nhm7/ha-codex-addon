#!/usr/bin/env bash
set -Eeuo pipefail

readonly RUNTIME_DIR=/run/codex-desktop
# shellcheck disable=SC1091
source "${RUNTIME_DIR}/environment"
cd "$(cat "${RUNTIME_DIR}/working-directory")"

args=()
while IFS= read -r encoded; do
  [[ -z "${encoded}" ]] && continue
  eval "args+=( ${encoded} )"
done < "${RUNTIME_DIR}/arguments"

printf '\033[1;36mCodex Desktop Community Add-on\033[0m\n'
printf 'Independent community project; not affiliated with or endorsed by OpenAI.\n\n'

codex "${args[@]}" || status=$?
status=${status:-0}
printf '\nCodex exited with status %s. Starting a local shell.\n' "${status}"
exec bash --login
