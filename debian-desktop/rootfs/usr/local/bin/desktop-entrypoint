#!/usr/bin/env bash
set -Eeuo pipefail

readonly OPTIONS_FILE=/data/options.json
readonly RUNTIME_DIR=/run/debian-desktop
readonly DISPLAY=:0
pids=()

log() { printf '[debian-desktop] %s\n' "$*"; }
cleanup() {
  log 'Stopping desktop services...'
  ((${#pids[@]} == 0)) || kill "${pids[@]}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

[[ -r "${OPTIONS_FILE}" ]] || { log "Cannot read Home Assistant options at ${OPTIONS_FILE}."; exit 1; }

resolution=$(jq -r '.resolution // "1440x900"' "${OPTIONS_FILE}")
[[ "${resolution}" =~ ^[0-9]{3,4}x[0-9]{3,4}$ ]] || { log 'Invalid resolution.'; exit 1; }
working_directory=$(jq -r '.working_directory // "/share"' "${OPTIONS_FILE}")
[[ -d "${working_directory}" ]] || { log "${working_directory} is not a directory; using /share."; working_directory=/share; }

mkdir -p "${RUNTIME_DIR}/xdg" /config/home /share /media
chmod 700 "${RUNTIME_DIR}" "${RUNTIME_DIR}/xdg" /config/home
export DISPLAY HOME=/config/home USER=root LOGNAME=root XDG_RUNTIME_DIR="${RUNTIME_DIR}/xdg"

# Xfce otherwise remembers a missing browser helper in the persistent profile.
# Point both its helper and the freedesktop MIME defaults at our container-safe
# Chrome launcher on every start, including for profiles created by old builds.
mkdir -p "${HOME}/.config/xfce4" "${HOME}/.config"
cat > "${HOME}/.config/xfce4/helpers.rc" <<'EOF'
WebBrowser=google-chrome
EOF
cat > "${HOME}/.config/mimeapps.list" <<'EOF'
[Default Applications]
text/html=google-chrome.desktop
x-scheme-handler/http=google-chrome.desktop
x-scheme-handler/https=google-chrome.desktop
EOF

while IFS= read -r entry; do
  [[ -z "${entry}" ]] && continue
  name=${entry%%=*}
  value=${entry#*=}
  if [[ "${entry}" != *=* || ! "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    log "Ignoring invalid environment entry: ${entry}"
    continue
  fi
  export "${name}=${value}"
done < <(jq -r '.environment[]? // empty' "${OPTIONS_FILE}")

startup_file="${RUNTIME_DIR}/startup.sh"
jq -r '.startup_script // ""' "${OPTIONS_FILE}" > "${startup_file}"
chmod 700 "${startup_file}"
cd "${working_directory}"
bash "${startup_file}"

log "Starting virtual display at ${resolution}."
Xvfb "${DISPLAY}" -screen 0 "${resolution}x24" -nolisten tcp -noreset &
pids+=("$!")
for _ in $(seq 1 100); do
  [[ -S /tmp/.X11-unix/X0 ]] && break
  sleep 0.1
done
[[ -S /tmp/.X11-unix/X0 ]] || { log 'Virtual display failed to start.'; exit 1; }

eval "$(dbus-launch --sh-syntax)"
log 'Starting Xfce.'
startxfce4 &
pids+=("$!")

log 'Starting loopback-only VNC and Home Assistant Ingress gateway.'
x11vnc -display "${DISPLAY}" -localhost -rfbport 5900 -forever -shared -nopw \
  -noxdamage -xrandr resize &
pids+=("$!")
websockify --web=/usr/share/novnc 0.0.0.0:8099 localhost:5900 &
gateway_pid=$!
pids+=("${gateway_pid}")
wait "${gateway_pid}"
